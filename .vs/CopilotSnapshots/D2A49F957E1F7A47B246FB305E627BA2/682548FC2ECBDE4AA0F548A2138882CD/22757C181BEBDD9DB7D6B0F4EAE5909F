<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Expense Tracker</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="../Content/css/style.css">
</head>

<body>
    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        <nav id="sidebar">
            <div class="sidebar-header">
                <h3><i class="fa-solid fa-wallet"></i> Expense Tracker</h3>
            </div>

            <ul class="list-unstyled components">
                <li class="active">
                    <a href="Dashboard.html"><i class="fa-solid fa-house"></i> Dashboard</a>
                </li>
                <li>
                    <a href="Income.html"><i class="fa-solid fa-arrow-turn-down text-success"></i> Income</a>
                </li>
                <li>
                    <a href="#"><i class="fa-solid fa-arrow-trend-up text-danger"></i> Expenses</a>
                </li>
                <li>
                    <a href="#"><i class="fa-solid fa-tags"></i> Categories</a>
                </li>
                <li>
                    <a href="#"><i class="fa-solid fa-chart-pie"></i> Reports</a>
                </li>
                <li>
                    <a href="#"><i class="fa-solid fa-gear"></i> Settings</a>
                </li>
                <li>
                    <a href="#"><i class="fa-solid fa-circle-info"></i> About</a>
                </li>
            </ul>
        </nav>
        <!-- /#sidebar -->

        <!-- Page Content -->
        <div id="content">

            <!-- Top Navbar -->
            <nav class="navbar navbar-expand-lg navbar-light">
                <div class="container-fluid">
                    <span class="navbar-brand mb-0 h1">Dashboard</span>

                    <div class="ms-auto d-flex align-items-center">
                        <span class="me-3 text-muted d-none d-md-inline" id="currentDate">Date</span>

                        <!-- Notifications -->
                        <div class="nav-item position-relative me-3">
                            <a class="nav-link text-secondary" href="#">
                                <i class="fa-solid fa-bell fs-5"></i>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                    3+
                                </span>
                            </a>
                        </div>

                        <!-- Settings -->
                        <div class="nav-item">
                            <a class="nav-link text-secondary" href="#">
                                <i class="fa-solid fa-gear fs-5"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </nav>

            <!-- Main Content Area -->
            <div class="container-fluid p-4">

                <!-- Dashboard Header -->
                <div class="dashboard-header mb-4">
                    <h2>Welcome 👋</h2>
                    <p class="mb-0 fs-5 text-dark font-weight-bold">Expense Tracker Dashboard</p>
                    <p>Track your income and expenses easily.</p>
                </div>

                <!-- Summary Cards Row -->
                <div class="row mb-4">
                    <!-- Current Balance Card -->
                    <div class="col-xl-3 col-md-6 mb-4">
                        <div class="card border-left-primary h-100 py-2">
                            <div class="card-body">
                                <div class="row no-gutters align-items-center">
                                    <div class="col mr-2">
                                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                            Current Balance</div>
                                        <div class="h5 mb-0 font-weight-bold text-gray-800">₹15,000</div>
                                    </div>
                                    <div class="col-auto">
                                        <i class="fa-solid fa-wallet fa-2x text-gray-300" style="color: #dddfeb;"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Total Income Card -->
                    <div class="col-xl-3 col-md-6 mb-4">
                        <div class="card border-left-success h-100 py-2">
                            <div class="card-body">
                                <div class="row no-gutters align-items-center">
                                    <div class="col mr-2">
                                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                            Total Income</div>
                                        <div class="h5 mb-0 font-weight-bold text-gray-800">₹35,000</div>
                                    </div>
                                    <div class="col-auto">
                                        <i class="fa-solid fa-indian-rupee-sign fa-2x text-gray-300" style="color: #dddfeb;"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Total Expense Card -->
                    <div class="col-xl-3 col-md-6 mb-4">
                        <div class="card border-left-danger h-100 py-2">
                            <div class="card-body">
                                <div class="row no-gutters align-items-center">
                                    <div class="col mr-2">
                                        <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">
                                            Total Expense</div>
                                        <div class="h5 mb-0 font-weight-bold text-gray-800">₹20,000</div>
                                    </div>
                                    <div class="col-auto">
                                        <i class="fa-solid fa-money-bill-transfer fa-2x text-gray-300" style="color: #dddfeb;"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Total Categories Card -->
                    <div class="col-xl-3 col-md-6 mb-4">
                        <div class="card border-left-warning h-100 py-2">
                            <div class="card-body">
                                <div class="row no-gutters align-items-center">
                                    <div class="col mr-2">
                                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                            Total Categories</div>
                                        <div class="h5 mb-0 font-weight-bold text-gray-800">6</div>
                                    </div>
                                    <div class="col-auto">
                                        <i class="fa-solid fa-list fa-2x text-gray-300" style="color: #dddfeb;"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <!-- Recent Transactions -->
                    <div class="col-lg-8 mb-4">
                        <div class="card shadow mb-4 h-100">
                            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between bg-white border-bottom">
                                <h6 class="m-0 font-weight-bold text-primary">Recent Transactions</h6>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive bg-white shadow-none p-0">
                                    <table class="table table-hover mb-0">
                                        <thead>
                                            <tr>
                                                <th>Date</th>
                                                <th>Category</th>
                                                <th>Description</th>
                                                <th>Payment</th>
                                                <th>Amount</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>2023-10-01</td>
                                                <td><span class="badge bg-primary">Food</span></td>
                                                <td>Lunch at Restaurant</td>
                                                <td>Card</td>
                                                <td class="text-danger">-₹500</td>
                                            </tr>
                                            <tr>
                                                <td>2023-10-03</td>
                                                <td><span class="badge bg-success">Shopping</span></td>
                                                <td>Shoes</td>
                                                <td>Cash</td>
                                                <td class="text-danger">-₹2,000</td>
                                            </tr>
                                            <tr>
                                                <td>2023-10-05</td>
                                                <td><span class="badge bg-info">Travel</span></td>
                                                <td>Bus Ticket</td>
                                                <td>UPI</td>
                                                <td class="text-danger">-₹300</td>
                                            </tr>
                                            <tr>
                                                <td>2023-10-08</td>
                                                <td><span class="badge bg-warning text-dark">Medical</span></td>
                                                <td>Medicines</td>
                                                <td>Card</td>
                                                <td class="text-danger">-₹1,200</td>
                                            </tr>
                                            <tr>
                                                <td>2023-10-10</td>
                                                <td><span class="badge bg-secondary">Bills</span></td>
                                                <td>Electricity Bill</td>
                                                <td>UPI</td>
                                                <td class="text-danger">-₹1,500</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Chart and Quick Stats -->
                    <div class="col-lg-4 mb-4">

                        <!-- Expense Category Chart -->
                        <div class="card shadow mb-4">
                            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between bg-white border-bottom">
                                <h6 class="m-0 font-weight-bold text-primary">Expenses by Category</h6>
                            </div>
                            <div class="card-body">
                                <div class="chart-pie pt-4 pb-2" style="height: 250px;">
                                    <canvas id="expenseChart"></canvas>
                                </div>
                            </div>
                        </div>

                        <!-- Quick Statistics -->
                        <div class="quick-stats mt-4 shadow" style="padding: 0;">
                            <div class="card-header py-3 bg-white border-bottom" style="border-radius: 10px 10px 0 0;">
                                <h6 class="m-0 font-weight-bold text-primary">Quick Statistics</h6>
                            </div>
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between quick-stats-item">
                                    <span class="text-muted">Highest Expense</span>
                                    <span class="font-weight-bold text-danger">₹2,000 (Shopping)</span>
                                </div>
                                <div class="d-flex justify-content-between quick-stats-item">
                                    <span class="text-muted">Lowest Expense</span>
                                    <span class="font-weight-bold">₹300 (Travel)</span>
                                </div>
                                <div class="d-flex justify-content-between quick-stats-item">
                                    <span class="text-muted">This Month Expense</span>
                                    <span class="font-weight-bold text-danger">₹5,500</span>
                                </div>
                                <div class="d-flex justify-content-between quick-stats-item">
                                    <span class="text-muted">Remaining Balance</span>
                                    <span class="font-weight-bold text-success">₹15,000</span>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
            <!-- /.container-fluid -->

        </div>
        <!-- /#content -->
    </div>

    <!-- Bootstrap 5 JS Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@2.9.4/dist/Chart.min.js"></script>

    <!-- Custom JS -->
    <script src="../Scripts/js/dashboard.js"></script>
</body>

</html>